{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowYourLimits",
  "version": "0.2.9",
  "identifier": "dev.knowyourlimits.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KnowYourLimits",
        "width": 360,
        "height": 620,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMDg3MDY2NTFBRjE2QTkKUldTcEZxOVJabkFJb0ZMeTdDZDQ5MTc5bEJ6dHBpb0FkMUZqRjBsSkd6b3VZME8rMGxRYjE2Wk4K",
      "endpoints": [
        "https://zamok01.bshk.app/api/products/knowyourlimits/updater/{{target}}/{{arch}}/{{current_version}}?channel=stable"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
